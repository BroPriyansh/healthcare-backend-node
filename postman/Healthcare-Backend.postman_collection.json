{
  "info": {
    "_postman_id": "d4e83b6b-19aa-4d8c-8b6d-2e67a1f83f21",
    "name": "Healthcare Backend API (Node.js)",
    "description": "End-to-end requests for the Healthcare Backend assignment. Run in order; IDs and JWTs are captured automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:3000"},
    {"key":"accessToken","value":""},
    {"key":"refreshToken","value":""},
    {"key":"patientId","value":"1"},
    {"key":"doctorId","value":"1"},
    {"key":"mappingId","value":"1"}
  ],
  "item": [
    {"name":"Health Check","request":{"method":"GET","url":"{{baseUrl}}/api/health"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('API is healthy', () => pm.response.to.have.status(200));"]}}]},
    {"name":"Register User","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Aarav Sharma\",\"email\":\"aarav@example.com\",\"password\":\"StrongPass123\"}"},"url":"{{baseUrl}}/api/auth/register"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('User registered (or already exists)', () => pm.expect([201,409]).to.include(pm.response.code));"]}}]},
    {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"aarav@example.com\",\"password\":\"StrongPass123\"}"},"url":"{{baseUrl}}/api/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set('accessToken', data.tokens.access); pm.collectionVariables.set('refreshToken', data.tokens.refresh); }","pm.test('Login succeeds', () => pm.response.to.have.status(200));"]}}]},
    {"name":"Refresh Tokens","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"refresh\":\"{{refreshToken}}\"}"},"url":"{{baseUrl}}/api/auth/refresh"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set('accessToken', data.tokens.access); pm.collectionVariables.set('refreshToken', data.tokens.refresh); }"]}}]},
    {"name":"Create Patient","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{accessToken}}"}],"body":{"mode":"raw","raw":"{\"name\":\"Meera Sharma\",\"age\":34,\"gender\":\"female\",\"address\":\"12 Park Street, Agra\",\"phone\":\"9876543210\"}"},"url":"{{baseUrl}}/api/patients"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["if (pm.response.code === 201) pm.collectionVariables.set('patientId', pm.response.json().patient.id);"]}}]},
    {"name":"List Patients","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/patients"}},
    {"name":"Get Patient","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/patients/{{patientId}}"}},
    {"name":"Update Patient","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{accessToken}}"}],"body":{"mode":"raw","raw":"{\"name\":\"Meera Sharma\",\"age\":35,\"gender\":\"female\",\"address\":\"Updated address, Agra\",\"phone\":\"9876543210\"}"},"url":"{{baseUrl}}/api/patients/{{patientId}}"}},
    {"name":"Create Doctor","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{accessToken}}"}],"body":{"mode":"raw","raw":"{\"name\":\"Dr. Riya Verma\",\"specialization\":\"Cardiology\",\"email\":\"riya.verma@example.com\",\"phone\":\"9876543211\",\"clinic_address\":\"Civil Lines, Agra\"}"},"url":"{{baseUrl}}/api/doctors"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["if (pm.response.code === 201) pm.collectionVariables.set('doctorId', pm.response.json().doctor.id);"]}}]},
    {"name":"List Doctors","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/doctors"}},
    {"name":"Get Doctor","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/doctors/{{doctorId}}"}},
    {"name":"Update Doctor","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{accessToken}}"}],"body":{"mode":"raw","raw":"{\"name\":\"Dr. Riya Verma\",\"specialization\":\"Cardiology\",\"email\":\"riya.verma@example.com\",\"phone\":\"9876543211\",\"clinic_address\":\"Updated clinic address, Agra\"}"},"url":"{{baseUrl}}/api/doctors/{{doctorId}}"}},
    {"name":"Assign Doctor to Patient","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{accessToken}}"}],"body":{"mode":"raw","raw":"{\"patient_id\":{{patientId}},\"doctor_id\":{{doctorId}}}"},"url":"{{baseUrl}}/api/mappings"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["if (pm.response.code === 201) pm.collectionVariables.set('mappingId', pm.response.json().mapping.id);"]}}]},
    {"name":"List Mappings","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/mappings"}},
    {"name":"Get Doctors for Patient","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/mappings/{{patientId}}"}},
    {"name":"Remove Mapping","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/mappings/{{mappingId}}"}},
    {"name":"Delete Doctor","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/doctors/{{doctorId}}"}},
    {"name":"Delete Patient","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/patients/{{patientId}}"}}
  ]
}
